<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="mail_notification_layout_brand" inherit_id="mail.mail_notification_layout">
        <xpath expr="//a[contains(@href, 'utm_medium=email')]" position="replace">
            <a target="_blank" href="https://altiusol.com"
               t-attf-style="color: {{company.email_secondary_color or '#4F46E5'}};">Altius ERP</a>
        </xpath>
    </template>

    <template id="mail_notification_light_brand" inherit_id="mail.mail_notification_light">
        <xpath expr="//a[contains(@href, 'utm_medium=email')]" position="replace">
            <a target="_blank" href="https://altiusol.com"
               t-attf-style="color: {{company.email_secondary_color or '#4F46E5'}};">Altius ERP</a>
        </xpath>
        <xpath expr="//td[@align='right']" position="attributes">
            <attribute name="t-if">company</attribute>
        </xpath>
    </template>

</odoo>
